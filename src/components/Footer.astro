    <a href={profile.github} rel="me">GitHub</a>
    <a href={profile.linkedin} rel="me">LinkedIn</a>
    <a href={profile.scholar}>Scholar</a>
  </div>
  <p class="footer-meta">© {new Date().getFullYear()} Sang Truong · Built for clarity, speed, and evidence.</p>
</footer>
