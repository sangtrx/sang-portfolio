---
import { profile } from '../data/site';
import { withBase } from '../lib/paths';
---
<footer class="footer container">
  <div>
    <p class="footer-title">Build something difficult.</p>
    <p class="muted">Production AI, reliable agents, research infrastructure, and end-to-end product engineering.</p>
  </div>
  <div class="footer-links">
    <a href={withBase('/about')}>About</a>
    <a href={withBase('/resume')}>Résumé</a>
    <a href={`mailto:${profile.email}`}>Email</a>
    <a href={profile.github} rel="me">GitHub</a>
    <a href={profile.linkedin} rel="me">LinkedIn</a>
    <a href={profile.scholar}>Scholar</a>
  </div>
  <p class="footer-meta">© {new Date().getFullYear()} Sang Truong · Built for clarity, speed, evidence, and truthful system status.</p>
</footer>
