---
import { withBase } from '../lib/paths';

const proofs = [
  {
    eyebrow: 'Clinical AI',
    title: 'Governed clinical intelligence',
    owner: 'EPIC TECHNOLOGY · AI Architect / Lead Builder',
    stages: ['Clinician workflow', 'AI reasoning', 'Governed evidence', 'Clinical authority'],
    note: 'Shows the authority boundary, not the private corpus, prompts, infrastructure, or deployment topology.',
    href: withBase('/work/yhct'),
  },
  {
    eyebrow: 'Physical-world AI',
    title: 'Video intelligence under real constraints',
    owner: 'EPIC TECHNOLOGY · AI / Computer Vision Systems Lead',
    stages: ['Media sources', 'Perception', 'Temporal state', 'Evidence & recovery'],
    note: 'The public view keeps vendor details, camera topology, credentials, and operational runbooks private.',
  },
  {
    eyebrow: 'Quant systems',
    title: 'Research discipline → guarded runtime',
    owner: 'Independent side project · Solo Builder',
    stages: ['PIT evidence', 'Evaluation', 'Runtime state', 'Public verification'],
    note: 'Strategy parameters, private data sources, execution controls, and trading authority are intentionally excluded.',
    href: withBase('/work/curren'),
  },
  {
    eyebrow: 'Research',
    title: 'Methods that survive beyond a paper',
    owner: 'University of Arkansas · Applied Research',
    stages: ['Research question', 'Representation', 'Evaluation', 'Target hardware'],
    note: 'Peer-reviewed work and deployment constraints are public; proprietary datasets and unsupported production claims are not.',
  },
];
---

<section id="proof" class="container section section-rule">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Selected system boundaries</p>
      <h2>Enough detail to prove depth. Not enough to leak the playbook.</h2>
    </div>
    <p class="section-note">These are intentionally abstracted architecture cuts: ownership, state, evidence, and failure boundaries are visible; sensitive implementation and operational details stay private.</p>
  </div>

  <div class="boundary-grid">
    {proofs.map((proof) => (
      <article class="boundary-card">
        <div class="boundary-copy">
          <p class="proof-eyebrow">{proof.eyebrow}</p>
          <h3>{proof.title}</h3>
          <p class="proof-owner">{proof.owner}</p>
        </div>
        <div class="boundary-flow" aria-label={`${proof.title} high-level system flow`}>
          {proof.stages.map((stage, index) => (
            <>
              <span>{stage}</span>
              {index < proof.stages.length - 1 && <i aria-hidden="true">→</i>}
            </>
          ))}
        </div>
        <p class="boundary-note">{proof.note}</p>
        {proof.href && <a class="text-link" href={proof.href}>Read the public case study <span aria-hidden="true">↗</span></a>}
      </article>
    ))}
  </div>
</section>

<style>
  .boundary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .boundary-card {
    min-width: 0;
    padding: clamp(28px, 4vw, 46px);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 95%, var(--accent));
  }

  .proof-eyebrow {
    margin: 0;
    color: var(--accent);
    font: 650 .7rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .boundary-card h3 {
    margin: 10px 0 8px;
    max-width: 18ch;
    font-size: clamp(1.45rem, 2.5vw, 2.4rem);
    line-height: 1;
    letter-spacing: -.04em;
  }

  .proof-owner,
  .boundary-note {
    color: var(--muted);
  }

  .proof-owner {
    margin: 0;
    font-size: .78rem;
    font-weight: 620;
  }

  .boundary-flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 34px 0 22px;
  }

  .boundary-flow span {
    padding: 9px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg);
    font: 620 .72rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .boundary-flow i {
    color: var(--accent);
    font-style: normal;
  }

  .boundary-note {
    max-width: 58ch;
    margin: 0;
    font-size: .9rem;
  }

  @media (max-width: 820px) {
    .boundary-grid { grid-template-columns: 1fr; }
  }
</style>
