---
import { withBase } from '../lib/paths';

const cameraRef = '669156d73de8a25ea3a976f27ad23602181c0a38';
const edxRef = '1bcddc2b51a858e2c864ebe3126c5aecc6763ae2';

const proofs = [
  {
    kind: 'iframe',
    eyebrow: 'Clinical AI · system artifact',
    title: 'YHCT clinical decision-support boundary',
    media: withBase('/yhct-clinical-architecture.html'),
    alt: 'Interactive YHCT clinical AI architecture artifact',
    owner: 'EPIC TECHNOLOGY · AI Architect / Lead Builder',
    boundary: 'Clinician request → semantic-owner agent → bounded approved-corpus research → deterministic clinical authority → evidence/citation state.',
    fact: 'The public artifact separates model reasoning from governed clinical facts, evidence state, auditability, and protected-UAT acceptance boundaries.',
    source: withBase('/work/yhct'),
    sourceLabel: 'Open YHCT case study',
  },
  {
    kind: 'image',
    eyebrow: 'Computer vision · committed screenshot',
    title: 'Production multi-camera video intelligence',
    media: `https://raw.githubusercontent.com/sangtrx/webserver/${cameraRef}/1.png`,
    alt: 'Committed screenshot from the production multi-camera video intelligence repository',
    owner: 'EPIC TECHNOLOGY · AI / Computer Vision Systems Lead',
    boundary: 'Camera media ingest and normalization → motion-triggered YOLO11/ALPR/ByteTrack workflows → event evidence → dashboard/alerts → guarded recovery.',
    fact: 'Current repository authority documents 21 active logical feeds across 22 stable server IDs, with native media bridges, stable aliases, evidence capture, access control, monitoring, and recovery.',
    source: `https://github.com/sangtrx/webserver/blob/${cameraRef}/1.png`,
    sourceLabel: 'View committed screenshot',
  },
  {
    kind: 'image',
    eyebrow: 'Education AI · rendered workflow',
    title: 'Open edX course-generation pipeline',
    media: `https://raw.githubusercontent.com/sangtrx/edx-ai/${edxRef}/docs/diagrams/openedx-ai/png/course-generation-pipeline.png`,
    alt: 'Rendered Open edX AI course-generation pipeline diagram committed in the edx-ai repository',
    owner: 'EPIC TECHNOLOGY · AI Architect / Lead Builder',
    boundary: 'Source material → grounded course-generation stages → teacher review → OLX packaging/import boundary.',
    fact: 'This PNG is a rendered, repository-committed artifact from the same Open edX implementation that carries course-factory agent skills, OLX builders, QA checks, and deployment verification.',
    source: `https://github.com/sangtrx/edx-ai/blob/${edxRef}/docs/diagrams/openedx-ai/png/course-generation-pipeline.png`,
    sourceLabel: 'View committed diagram',
  },
  {
    kind: 'image',
    eyebrow: 'Education AI · voice workflow',
    title: 'Vietnamese SGK helper voice path',
    media: `https://raw.githubusercontent.com/sangtrx/edx-ai/${edxRef}/docs/diagrams/openedx-ai/png/sgk-helper-voice-flow.png`,
    alt: 'Rendered SGK helper voice workflow diagram committed in the edx-ai repository',
    owner: 'EPIC TECHNOLOGY · AI Architect / Lead Builder',
    boundary: 'Browser interaction → Vietnamese speech path → tutoring/context services → guarded learning surface.',
    fact: 'The committed workflow artifact is part of the Open edX system documentation alongside WebSocket, tutoring, course-generation, and operations handoff material.',
    source: `https://github.com/sangtrx/edx-ai/blob/${edxRef}/docs/diagrams/openedx-ai/png/sgk-helper-voice-flow.png`,
    sourceLabel: 'View committed diagram',
  },
  {
    kind: 'iframe',
    eyebrow: 'Quant systems · system artifact',
    title: 'Curren research-to-production boundary',
    media: withBase('/curren-platform-architecture.html'),
    alt: 'Interactive Curren platform architecture artifact',
    owner: 'Independent side project · Solo Builder',
    boundary: 'Point-in-time research evidence → shared causal primitives/events → quality/risk/lifecycle state → guarded execution/reconciliation → read-only public verification.',
    fact: 'The public artifact explicitly keeps research evidence, live state, execution authority, and public verification separate; profitable live alpha is not claimed.',
    source: withBase('/work/curren'),
    sourceLabel: 'Open Curren case study',
  },
];
---

<section id="proof" class="container section section-rule">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Real project proof</p>
      <h2>Inspect the artifacts, not just the claims.</h2>
    </div>
    <p class="section-note">Five source-backed surfaces from shipped or actively validated systems. Existing YHCT/Curren artifacts are reused rather than redrawn; repository images are pinned to immutable Git SHAs.</p>
  </div>

  <div class="proof-grid">
    {proofs.map((proof) => (
      <article class="proof-card">
        <a class="proof-media" href={proof.source} aria-label={`${proof.sourceLabel}: ${proof.title}`}>
          {proof.kind === 'iframe' ? (
            <iframe src={proof.media} title={proof.alt} loading="lazy" tabindex="-1"></iframe>
          ) : (
            <img src={proof.media} alt={proof.alt} loading="lazy" decoding="async" />
          )}
          <span class="proof-open">{proof.sourceLabel} ↗</span>
        </a>
        <div class="proof-copy">
          <p class="proof-eyebrow">{proof.eyebrow}</p>
          <h3>{proof.title}</h3>
          <p class="proof-owner">{proof.owner}</p>
          <dl>
            <div><dt>System boundary</dt><dd>{proof.boundary}</dd></div>
            <div><dt>Concrete fact</dt><dd>{proof.fact}</dd></div>
          </dl>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .proof-card {
    min-width: 0;
    background: var(--surface);
  }

  .proof-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
  }

  .proof-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 82%, var(--text));
  }

  .proof-card:last-child:nth-child(odd) .proof-media {
    aspect-ratio: auto;
    min-height: 390px;
    border-bottom: 0;
    border-right: 1px solid var(--line);
  }

  .proof-media img,
  .proof-media iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    object-fit: contain;
    background: #fff;
  }

  .proof-media iframe {
    pointer-events: none;
  }

  .proof-open {
    position: absolute;
    right: 14px;
    bottom: 14px;
    padding: 8px 10px;
    border: 1px solid color-mix(in srgb, var(--line-strong) 78%, transparent);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    color: var(--text);
    font: 650 .68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    backdrop-filter: blur(10px);
  }

  .proof-copy {
    padding: clamp(24px, 3vw, 36px);
  }

  .proof-eyebrow,
  .proof-owner {
    margin: 0;
    color: var(--muted);
    font-size: .76rem;
  }

  .proof-eyebrow {
    color: var(--accent);
    font: 650 .7rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .proof-copy h3 {
    margin: 10px 0 9px;
    max-width: 25ch;
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    line-height: 1.1;
    letter-spacing: -.025em;
  }

  .proof-owner {
    font-weight: 620;
  }

  .proof-copy dl {
    margin: 24px 0 0;
  }

  .proof-copy dl > div {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 18px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
  }

  .proof-copy dt {
    color: var(--muted);
    font: 650 .68rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .proof-copy dd {
    margin: 0;
    color: color-mix(in srgb, var(--text) 84%, var(--muted));
    font-size: .87rem;
  }

  @media (max-width: 860px) {
    .proof-grid {
      grid-template-columns: 1fr;
    }

    .proof-card:last-child:nth-child(odd) {
      grid-column: auto;
      display: block;
    }

    .proof-card:last-child:nth-child(odd) .proof-media {
      aspect-ratio: 16 / 10;
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .proof-copy dl > div {
      grid-template-columns: 1fr;
      gap: 7px;
    }
  }
</style>
