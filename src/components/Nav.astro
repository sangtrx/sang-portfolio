---
import { withBase } from '../lib/paths';

const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { href: withBase('#work'), label: 'Work', current: false, compact: false },
  { href: withBase('#experience'), label: 'Experience', current: false, compact: true },
  { href: withBase('/about'), label: 'About', current: path.endsWith('/about'), compact: false },
  { href: withBase('/resume'), label: 'Résumé', current: path.endsWith('/resume'), compact: false },
];
---
<header class="nav-wrap">
  <nav class="nav container" aria-label="Primary navigation">
    <a class="brand" href={withBase()} aria-label="Sang Truong home">
      <span class="brand-mark" aria-hidden="true">ST</span>
      <span>Sang Truong</span>
    </a>
    <div class="nav-actions">
      <div class="nav-links">
        {links.map((link) => (
          <a class:list={{ 'nav-compact': link.compact }} href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>
        ))}
      </div>
      <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </nav>
</header>
