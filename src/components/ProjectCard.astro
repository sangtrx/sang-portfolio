---
import { withBase } from '../lib/paths';

interface Props {
  project: {
    slug: string;
    index: string;
    title: string;
    kicker: string;
    summary: string;
    role: string;
    year: string;
    status: string;
    proof: string[];
    tags: string[];
    href: string;
    accent: string;
  };
}
const { project } = Astro.props;
---
<a class={`project-card accent-${project.accent}`} href={withBase(project.href)} aria-label={`Open ${project.title} case study`}>
  <div class={`project-visual project-visual-${project.slug}`} aria-hidden="true">
    <span class="visual-grid"></span>
    <span class="visual-label">SYSTEM / {project.slug.toUpperCase()}</span>
    {project.slug === 'yhct' ? (
      <div class="visual-flow">
        <span>WORKFLOW</span><i>→</i><span class="hot">REASONING</span><i>→</i><span>EVIDENCE</span><i>→</i><span>AUTHORITY</span>
      </div>
    ) : (
      <div class="visual-flow">
        <span>EVIDENCE</span><i>→</i><span class="hot">RESEARCH</span><i>→</i><span>STATE</span><i>→</i><span>VERIFY</span>
      </div>
    )}
    <div class="visual-status">{project.status}</div>
  </div>
  <div class="project-copy">
    <div class="project-topline-visible"><span>Case study</span><span>{project.year}</span></div>
    <p class="project-role">{project.role}</p>
    <h3>{project.title}</h3>
    <p class="project-kicker">{project.kicker}</p>
    <p class="muted">{project.summary}</p>
    <div class="proof-row" aria-label="Project evidence">
      {project.proof.map((item) => <span>{item}</span>)}
    </div>
    <div class="tag-row" aria-label="Technologies and domains">
      {project.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
    <span class="text-link">Open case study <span aria-hidden="true">↗</span></span>
  </div>
</a>
