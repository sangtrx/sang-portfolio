---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  achievements,
  additionalExperience,
  capabilityDomains,
  education,
  epicSystems,
  experience,
  profile,
  projects,
  publications,
  researchTrajectory,
  skillGroups,
  teachingExperience,
} from '../data/site';
import { personId, personSchema, publicIdentity, websiteId, websiteSchema } from '../lib/identity';
import { withBase } from '../lib/paths';

const root = Astro.site ?? new URL('https://sangtruong.me');
const canonical = new URL(withBase('/resume'), root).href;
const currenProject = projects.find((item) => item.slug === 'curren');
const jsonLd = [
  personSchema(root),
  websiteSchema(root),
  {
    '@type': 'ProfilePage',
    '@id': `${canonical}#profile`,
    name: 'Résumé — Sang Truong',
    url: canonical,
    description: `Résumé for Sang Truong (${publicIdentity.handle}), senior AI engineer and applied AI lead in ${publicIdentity.location}.`,
    inLanguage: 'en',
    dateModified: '2026-08-28T14:50:00+07:00',
    isPartOf: { '@id': websiteId(root) },
    mainEntity: { '@id': personId(root) },
    about: { '@id': personId(root) },
  },
];
---
<BaseLayout
  title="Résumé — Sang Truong | Senior AI Engineer & Applied AI Lead"
  description="Résumé of Sang Truong (sangtrx), senior AI engineer and applied AI lead in Ho Chi Minh City, Vietnam, with 6+ years across LLM/RAG/agents, computer vision/video AI, multimodal research, quantitative ML, speech, edge inference, distributed backends, and production delivery."
  image="og-resume.png"
  imageAlt="Résumé of Sang Truong — Senior AI Engineer and Applied AI Lead"
  pageType="profile"
  jsonLd={jsonLd}
>
  <article class="resume-page container section">
    <header class="resume-header">
      <div>
        <p class="eyebrow">Résumé</p>
        <h1>Sang Truong</h1>
        <p class="resume-title">{profile.title}</p>
        <p class="muted">{publicIdentity.location} · GitHub @{publicIdentity.handle}</p>
      </div>
      <div class="resume-contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.github} rel="me">github.com/sangtrx</a>
        <a href={profile.linkedin} rel="me">linkedin.com/in/tqsang</a>
        <a href={profile.scholar} rel="me">Google Scholar</a>
      </div>
    </header>

    <section class="resume-block">
      <h2>Professional summary</h2>
      <p>Senior AI engineer and technical lead with 6+ years across LLM/RAG/agent systems, computer vision and video intelligence, multimodal learning, quantitative ML, time-series forecasting, speech AI, edge inference, and production AI engineering. I own systems end to end from research and data acquisition through model/tool design, APIs, distributed workloads, GPU/edge optimization, product surfaces, deployment, observability, reliability, and stakeholder delivery. Master of Engineering (MEng) in Computer Engineering with a 4.0/4.0 GPA and peer-reviewed work across IJCV, AAAI, IEEE JBHI, Poultry Science, IEEE Access, ICIP, BMVC, and IEEE BHI.</p>
    </section>

    <section class="resume-block">
      <h2>Domain depth</h2>
      <div class="domain-grid resume-domain-grid">
        {capabilityDomains.map((domain) => (
          <article class="domain-card">
            <div class="domain-head"><span>{domain.index}</span><h3>{domain.title}</h3></div>
            <p class="domain-summary">{domain.summary}</p>
            <ul>{domain.evidence.map((item) => <li>{item}</li>)}</ul>
            <p class="domain-stack">{domain.stack}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-block">
      <h2>Professional & research experience</h2>
      <div class="resume-list detailed-resume-list">
        {experience.map((item) => (
          <article>
            <span>{item.period}</span>
            <div>
              <h3>{item.role} · {item.company}</h3>
              <p>{item.summary}</p>
              <ul class="resume-bullets">{item.details.map((detail) => <li>{detail}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    {currenProject && (
      <section class="resume-block">
        <h2>Selected independent side project</h2>
        <div class="resume-list detailed-resume-list">
          <article>
            <span>{currenProject.year}</span>
            <div>
              <h3><a href={withBase(currenProject.href)}>{currenProject.title}</a> · {currenProject.role}</h3>
              <p>{currenProject.summary}</p>
              <p class="resume-status">{currenProject.status}</p>
            </div>
          </article>
        </div>
      </section>
    )}

    <section class="resume-block">
      <h2>Selected flagship systems under EPIC TECHNOLOGY</h2>
      <div class="resume-list detailed-resume-list">
        {epicSystems.map((item) => (
          <article>
            <span>{item.period}</span>
            <div>
              <h3>{item.href ? <a href={withBase(item.href)}>{item.title}</a> : item.title}</h3>
              <p class="resume-status">{item.owner}</p>
              <p>{item.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-block">
      <h2>Additional industry experience</h2>
      <div class="resume-list detailed-resume-list">
        {additionalExperience.map((item) => (
          <article>
            <span>{item.period}</span>
            <div>
              <h3>{item.role} · {item.company}</h3>
              <ul class="resume-bullets">{item.details.map((detail) => <li>{detail}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-block">
      <h2>Research trajectory</h2>
      <div class="resume-list">
        {researchTrajectory.map((item) => <article><span>{item.period}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div></article>)}
      </div>
    </section>

    <section class="resume-block">
      <h2>Teaching experience</h2>
      <div class="resume-list detailed-resume-list">
        {teachingExperience.map((item) => (
          <article>
            <span>{item.period}</span>
            <div>
              <h3>{item.role} · {item.company}</h3>
              <p>{item.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-block">
      <h2>Technical skills</h2>
      <div class="skill-grid resume-skill-grid">{skillGroups.map((group) => <article><h3>{group.title}</h3><p>{group.items.join(' · ')}</p></article>)}</div>
    </section>

    <section class="resume-block">
      <h2>Education</h2>
      <div class="resume-list">{education.map((item) => <article><span>{item.period}</span><div><h3>{item.title} · {item.institution}</h3><p>{item.detail}</p></div></article>)}</div>
      <p class="muted">Prior Ph.D.-track research is represented in the University of Arkansas research role above; no completed Ph.D. is claimed.</p>
    </section>

    <section class="resume-block">
      <h2>Selected scholarships & early honors</h2>
      <div class="resume-list">{achievements.map((item) => <article><span>{item.year}</span><div><h3>{item.title}</h3><p>{item.institution}</p></div></article>)}</div>
    </section>

    <section class="resume-block">
      <h2>Selected publications</h2>
      <div class="resume-list">{publications.map((item) => <article><span>{item.year}</span><div><h3><a href={item.href}>{item.title}</a> · {item.venue}</h3><p>{item.detail}</p></div></article>)}</div>
    </section>

    <section class="resume-block resume-source">
      <h2>Source & evidence</h2>
      <p>The public web résumé follows the current canonical résumé architecture: shared chronology and factual boundaries, plus separate depth layers for Applied AI/LLM systems, Computer Vision/Video AI, Quantitative Research/Trading Systems, and academic research. Public evidence is exposed through case studies, GitHub activity, and Google Scholar; confidential project material, credentials, internal infrastructure labels, patient data, and private trading alpha remain excluded.</p>
      <div class="hero-actions"><a class="button ghost" href={withBase('/#work')}>Project case studies</a><a class="button ghost" href={profile.scholar}>Google Scholar ↗</a></div>
    </section>
  </article>
</BaseLayout>
