---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience, profile, projects, publications } from '../data/site';
import { withBase } from '../lib/paths';
---
<BaseLayout title="Résumé — Sang Truong" description="Résumé of Sang Truong, AI/LLM engineer, technical lead, researcher, and builder.">
  <article class="resume-page container section">
    <header class="resume-header">
      <div>
        <p class="eyebrow">Résumé</p>
        <h1>Sang Truong</h1>
        <p class="resume-title">Senior AI/LLM Engineer · Technical Lead</p>
      </div>
      <div class="resume-contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.github}>github.com/sangtrx</a>
        <a href={profile.linkedin}>linkedin.com/in/tqsang</a>
      </div>
    </header>

    <section class="resume-block">
      <h2>Summary</h2>
      <p>Senior AI/LLM engineer and technical lead with 6+ years of experience building production AI products across agentic and RAG systems, voice AI, computer vision, and time-series forecasting. End-to-end ownership from model and retrieval architecture through APIs, distributed workloads, deployment, guardrails, and production verification.</p>
    </section>

    <section class="resume-block">
      <h2>Experience</h2>
      <div class="resume-list">{experience.map((item) => <article><span>{item.period}</span><div><h3>{item.role} · {item.company}</h3><p>{item.summary}</p></div></article>)}</div>
    </section>

    <section class="resume-block">
      <h2>Selected projects</h2>
      <div class="resume-list">{projects.map((item) => <article><span>{item.year}</span><div><h3><a href={withBase(item.href)}>{item.title}</a></h3><p>{item.summary}</p></div></article>)}</div>
    </section>

    <section class="resume-block">
      <h2>Education</h2>
      <div class="resume-list">
        <article><span>2021 — 2023</span><div><h3>M.S. Computer Engineering · University of Arkansas</h3><p>GPA 4.0/4.0. Research in computer vision, multimodal AI, and medical time-series analysis.</p></div></article>
        <article><span>2015 — 2019</span><div><h3>B.S. Automation and Control Engineering · International University — VNU HCMC</h3><p>Top 1% of class; half-tuition scholarship recipient.</p></div></article>
      </div>
    </section>

    <section class="resume-block">
      <h2>Selected publications</h2>
      <div class="resume-list">{publications.map((item) => <article><span>{item.year}</span><div><h3><a href={item.href}>{item.title}</a> · {item.venue}</h3><p>{item.detail}</p></div></article>)}</div>
    </section>
  </article>
</BaseLayout>
