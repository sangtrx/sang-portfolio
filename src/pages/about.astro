---
import BaseLayout from '../layouts/BaseLayout.astro';
import { capabilityDomains, education, profile, publications, researchTrajectory, skillGroups } from '../data/site';
import { personId, personSchema, publicIdentity, websiteId, websiteSchema } from '../lib/identity';
import { withBase } from '../lib/paths';

const root = Astro.site ?? new URL('https://sangtruong.me');
const canonical = new URL(withBase('/about'), root).href;
const jsonLd = [
  personSchema(root),
  websiteSchema(root),
  {
    '@type': 'ProfilePage',
    '@id': `${canonical}#profile`,
    url: canonical,
    name: 'About Sang Truong | Senior AI Engineer & Applied AI Lead',
    description: `Public profile for Sang Truong (${publicIdentity.handle}), a senior AI engineer and applied AI lead based in ${publicIdentity.location}.`,
    inLanguage: 'en',
    dateModified: '2026-08-28T14:50:00+07:00',
    isPartOf: { '@id': websiteId(root) },
    mainEntity: { '@id': personId(root) },
    about: { '@id': personId(root) },
  },
];
---
<BaseLayout
  title="About Sang Truong | Senior AI Engineer & Applied AI Lead"
  description="About Sang Truong (sangtrx), a senior AI engineer and applied AI lead in Ho Chi Minh City, Vietnam, with deep experience across LLM/agent systems, computer vision/video AI, multimodal research, quantitative ML, edge inference, distributed backends, and production delivery."
  image="og-about.png"
  pageType="profile"
  jsonLd={jsonLd}
>
  <article class="about-page container section">
    <header class="about-hero">
      <p class="eyebrow">About</p>
      <h1>Research-trained. Systems-minded. Production accountable.</h1>
      <p class="about-lede">I'm Sang Truong (<a href={profile.github}>@{publicIdentity.handle}</a>), a senior AI engineer and applied AI lead based in {publicIdentity.location}. My work spans model research, LLM/agent systems, computer vision and video intelligence, quantitative ML, distributed backends, product engineering, cloud/edge deployment, and the operational boundaries that decide whether an AI system is actually trustworthy.</p>
    </header>

    <section class="about-grid section-rule">
      <div>
        <p class="eyebrow">Operating model</p>
        <h2>Own the path from research to acceptance.</h2>
      </div>
      <div class="prose-stack">
        <p>I am most useful when a system crosses several disciplines at once: research assumptions, data contracts, model/tool behavior, backend state, user experience, infrastructure, and stakeholder acceptance. I do not treat the model as the whole product.</p>
        <p>My current Head of AI role covers clinical AI, education AI, production computer vision/video intelligence, and AI platform engineering. Earlier work spans enterprise conversational agents, multilingual speech systems, environmental forecasting, quantitative research, multimodal/video research, and embedded computer vision.</p>
        <p>I prefer explicit boundaries over architecture theater: which component owns facts, what data was available at decision time, what can fail, what is recoverable, what has actually been validated, and what the system deliberately does not claim.</p>
      </div>
    </section>

    <section class="section-rule">
      <div class="section-heading compact-heading">
        <div><p class="eyebrow">Domain depth</p><h2>Specialized depth without amputating the rest of the career.</h2></div>
        <p class="section-note">The résumé architecture intentionally keeps one canonical chronology while expanding evidence by domain. These are the four recurring technical centers.</p>
      </div>
      <div class="domain-grid">
        {capabilityDomains.map((domain) => (
          <article class="domain-card">
            <div class="domain-head"><span>{domain.index}</span><h3>{domain.title}</h3></div>
            <p class="domain-summary">{domain.summary}</p>
            <ul>{domain.evidence.map((item) => <li>{item}</li>)}</ul>
            <p class="domain-stack">{domain.stack}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-rule about-grid">
      <div>
        <p class="eyebrow">How I think</p>
        <h2>Good AI systems are contracts, not demos.</h2>
      </div>
      <div class="decision-list">
        <article><strong>Preserve authority.</strong><p>Give models room to reason where useful while keeping authoritative facts, permissions, tools, and failure behavior explicit.</p></article>
        <article><strong>Preserve causality.</strong><p>In research and live systems, respect what information existed at decision time. Point-in-time discipline and provenance are engineering requirements.</p></article>
        <article><strong>Preserve evidence.</strong><p>Separate fluent output from the source, tool result, experiment, runtime observation, or acceptance gate that supports it.</p></article>
        <article><strong>Design for operation.</strong><p>State, retries, idempotency, restart behavior, monitoring, recovery, access control, deployment and handoff are part of the product.</p></article>
        <article><strong>Optimize on target hardware.</strong><p>For physical-world AI, camera/media reliability and target-device inference behavior matter more than isolated benchmark numbers.</p></article>
        <article><strong>State the boundary.</strong><p>Implemented, tested, deployed, accepted, and production-ready are different claims. I try to keep them different.</p></article>
      </div>
    </section>

    <section class="section-rule">
      <div class="section-heading compact-heading">
        <div><p class="eyebrow">Technical stack</p><h2>Tools organized by system responsibility.</h2></div>
        <p class="section-note">The stack is broad because the systems cross model, data, product, infrastructure, and physical-world boundaries.</p>
      </div>
      <div class="skill-grid">
        {skillGroups.map((group) => (
          <article><h3>{group.title}</h3><p>{group.items.join(' · ')}</p></article>
        ))}
      </div>
    </section>

    <section class="section-rule about-grid">
      <div><p class="eyebrow">Research trajectory</p><h2>From temporal video reasoning to applied AI systems.</h2></div>
      <div class="resume-list">
        {researchTrajectory.map((item) => <article><span>{item.period}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div></article>)}
      </div>
    </section>

    <section class="section-rule about-grid">
      <div><p class="eyebrow">Education</p><h2>Research-trained engineering.</h2></div>
      <div class="resume-list">
        {education.map((item) => <article><span>{item.period}</span><div><h3>{item.title} · {item.institution}</h3><p>{item.detail}</p></div></article>)}
      </div>
    </section>

    <section class="section-rule about-grid">
      <div><p class="eyebrow">Selected research</p><h2>Peer-reviewed work across multiple AI domains.</h2></div>
      <div class="publication-list">
        {publications.map((publication) => (
          <a class="publication" href={publication.href}>
            <span>{publication.year}</span>
            <span><strong>{publication.title}</strong><br />{publication.detail}</span>
            <span>{publication.venue}</span>
          </a>
        ))}
        <a class="text-link" href={profile.scholar}>Full Google Scholar profile <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="section-rule about-cta">
      <div><p class="eyebrow">Explore</p><h2>See the systems, chronology and evidence.</h2></div>
      <div class="hero-actions"><a class="button primary" href={withBase('/#work')}>Case studies</a><a class="button ghost" href={withBase('/resume')}>Full résumé</a></div>
    </section>
  </article>
</BaseLayout>
