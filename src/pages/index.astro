---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { experience, profile, projects, publications } from '../data/site';
import { withBase } from '../lib/paths';
---
<BaseLayout>
  <section class="hero container section">
    <div class="hero-grid">
      <div>
        <p class="eyebrow hero-eyebrow">{profile.eyebrow}</p>
        <h1>I build AI systems that have to work.</h1>
      </div>
      <div class="hero-side">
        <p class="hero-intro">{profile.intro}</p>
        <div class="hero-actions">
          <a class="button primary" href="#work">View selected systems</a>
          <a class="button ghost" href={withBase('/resume')}>Résumé</a>
        </div>
      </div>
    </div>
    <div class="signal-strip" aria-label="Profile highlights">
      <span><strong>6+ yrs</strong> building AI products</span>
      <span><strong>M.S. 4.0</strong> Computer Engineering</span>
      <span><strong>Research</strong> AAAI · IJCV · IEEE JBHI</span>
      <span><strong>Ownership</strong> model → production</span>
    </div>
  </section>

  <section id="work" class="container section section-rule">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Systems, not demos.</h2>
      </div>
      <p class="section-note">Two flagship case studies selected for depth, architecture, and real operational constraints.</p>
    </div>
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section id="experience" class="container section section-rule">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Experience</p>
        <h2>From research to production ownership.</h2>
      </div>
      <p class="section-note">Agentic AI, retrieval, speech, forecasting, computer vision, distributed workloads, and deployment.</p>
    </div>
    <div class="timeline">
      {experience.map((item) => (
        <article class="timeline-row">
          <p class="timeline-period">{item.period}</p>
          <div>
            <h3>{item.role}</h3>
            <p class="timeline-company">{item.company}</p>
          </div>
          <p class="muted">{item.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container section section-rule split-section">
    <div>
      <p class="eyebrow">Research</p>
      <h2>Peer-reviewed foundations.</h2>
      <p class="section-note wide">My academic work spans multimodal learning, temporal reasoning, computer vision, and medical time-series analysis.</p>
      <a class="text-link" href={profile.scholar}>Google Scholar <span aria-hidden="true">↗</span></a>
    </div>
    <div class="publication-list">
      {publications.map((publication) => (
        <a class="publication" href={publication.href}>
          <span>{publication.year}</span>
          <span><strong>{publication.title}</strong><br />{publication.detail}</span>
          <span>{publication.venue}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section contact-panel">
    <p class="eyebrow">Contact</p>
    <h2>Need someone who can own the whole system?</h2>
    <p>I'm interested in senior/lead AI engineering, AI product architecture, and technically demanding systems where reliability and evidence matter.</p>
    <div class="hero-actions">
      <a class="button primary" href={`mailto:${profile.email}`}>Start a conversation</a>
      <a class="button ghost" href={profile.github}>GitHub</a>
    </div>
  </section>
</BaseLayout>
