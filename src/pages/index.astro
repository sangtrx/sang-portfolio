---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  capabilityDomains,
  credibility,
  experience,
  ownership,
  profile,
  projects,
  publications,
  systemPortfolio,
} from '../data/site';
import { personId, personSchema, publicIdentity, websiteId, websiteSchema } from '../lib/identity';
import { withBase } from '../lib/paths';

const root = Astro.site ?? new URL('https://sangtruong.me');
const canonical = new URL(withBase('/'), root).href;
const featuredPublications = publications.slice(0, 4);
const jsonLd = [
  personSchema(root),
  websiteSchema(root),
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: 'Sang Truong | Senior AI Engineer & Applied AI Lead',
    description: 'Proof-of-work portfolio for Sang Truong (sangtrx), a senior AI engineer and applied AI lead spanning LLM/agent systems, computer vision/video AI, quantitative ML, multimodal research, and production engineering.',
    inLanguage: 'en',
    dateModified: '2026-08-28T14:50:00+07:00',
    isPartOf: { '@id': websiteId(root) },
    about: { '@id': personId(root) },
    mainEntity: { '@id': personId(root) },
  },
];
---
<BaseLayout
  title="Sang Truong | Senior AI Engineer & Applied AI Lead"
  description="Sang Truong (sangtrx) is a senior AI engineer and applied AI lead in Ho Chi Minh City, Vietnam, with 6+ years across LLM/RAG/agents, computer vision and video intelligence, multimodal AI, quantitative ML, speech, edge inference, distributed backends, and production delivery."
  jsonLd={jsonLd}
>
  <section class="hero container section">
    <div class="hero-grid">
      <div>
        <p class="role-line">{profile.name} · {profile.title}</p>
        <h1>I build AI systems that have to work.</h1>
      </div>
      <div class="hero-side">
        <p class="hero-intro">{profile.intro}</p>
        <p class="muted hero-identity">{publicIdentity.location} · GitHub <a href={profile.github}>@{publicIdentity.handle}</a></p>
        <div class="hero-actions">
          <a class="button primary" href="#work">View flagship systems</a>
          <a class="hero-text-link" href="#depth">Technical depth</a>
          <a class="hero-text-link" href={withBase('/resume')}>Résumé</a>
        </div>
      </div>
    </div>
    <div class="credibility-rail" aria-label="Profile highlights">
      {credibility.map((item) => <span><strong>{item.label}</strong>{item.value}</span>)}
    </div>
  </section>

  <section id="depth" class="container section section-rule">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Technical depth</p>
        <h2>One career, four deep engineering domains.</h2>
      </div>
      <p class="section-note">The current résumé family separates domain evidence instead of flattening everything into one generic skills list. The portfolio follows the same model: broad senior ownership, with inspectable depth in each domain.</p>
    </div>
    <div class="domain-grid">
      {capabilityDomains.map((domain) => (
        <article class="domain-card">
          <div class="domain-head"><span>{domain.index}</span><h3>{domain.title}</h3></div>
          <p class="domain-summary">{domain.summary}</p>
          <ul>{domain.evidence.map((item) => <li>{item}</li>)}</ul>
          <p class="domain-stack">{domain.stack}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="work" class="container section section-rule">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Deep case studies</p>
        <h2>Two systems with architecture and evidence exposed.</h2>
      </div>
      <p class="section-note">YHCT shows bounded clinical AI under a real hospital UAT boundary. Curren shows point-in-time quantitative research, live-system state, and a one-way public verification architecture. Both distinguish implementation, validation, deployment, and non-claims.</p>
    </div>
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="container section section-rule">
    <div class="section-heading">
      <div>
        <p class="eyebrow">System portfolio</p>
        <h2>The work is broader than two case studies.</h2>
      </div>
      <p class="section-note">Selected systems across healthcare, education, enterprise agents, physical-world video AI, and quantitative research. Ownership labels are explicit so client/employer work is not presented as unrelated personal projects.</p>
    </div>
    <div class="system-portfolio">
      {systemPortfolio.map((system, index) => {
        const content = (
          <>
            <div class="system-index"><span>{String(index + 1).padStart(2, '0')}</span><small>{system.period}</small></div>
            <div class="system-main">
              <p class="system-owner">{system.owner}</p>
              <h3>{system.title}</h3>
              <p>{system.summary}</p>
            </div>
            <div class="system-signal">{system.signal}{system.href && <span aria-hidden="true">↗</span>}</div>
          </>
        );
        return system.href ? <a class="system-row system-row-link" href={withBase(system.href)}>{content}</a> : <article class="system-row">{content}</article>;
      })}
    </div>
  </section>

  <section class="container section section-rule">
    <div class="section-heading">
      <div>
        <p class="eyebrow">End-to-end ownership</p>
        <h2>Beyond the model call.</h2>
      </div>
      <p class="section-note">The recurring pattern is turning research/model capability into a bounded system with explicit data, authority, failure, evaluation, operations, and acceptance contracts.</p>
    </div>
    <div class="ownership-grid ownership-grid-expanded">
      {ownership.map((item) => (
        <article class="ownership-card">
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="experience" class="container section section-rule">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Career</p>
        <h2>Research depth, product ownership, production constraints.</h2>
      </div>
      <p class="section-note">From embedded computer vision and quantitative systems to multimodal research, enterprise agents, hospital AI, education platforms, and production video intelligence.</p>
    </div>
    <div class="timeline">
      {experience.map((item) => (
        <article class="timeline-row">
          <p class="timeline-period">{item.period}</p>
          <div>
            <h3>{item.role}</h3>
            <p class="timeline-company">{item.company}</p>
          </div>
          <p class="muted">{item.summary}</p>
        </article>
      ))}
    </div>
    <a class="text-link" href={withBase('/resume')}>Full chronology, teaching, skills and honors <span aria-hidden="true">↗</span></a>
  </section>

  <section class="container section section-rule split-section">
    <div>
      <p class="eyebrow">Research</p>
      <h2>Peer-reviewed foundations.</h2>
      <p class="section-note wide">Work across temporal video understanding, actor/object/environment interaction modeling, vision-language learning, medical time-series representation learning, and industrial computer vision. VLTinT was selected as an AAAI 2023 Oral.</p>
      <a class="text-link" href={profile.scholar}>Google Scholar <span aria-hidden="true">↗</span></a>
    </div>
    <div class="publication-list">
      {featuredPublications.map((publication) => (
        <a class="publication" href={publication.href}>
          <span>{publication.year}</span>
          <span><strong>{publication.title}</strong><br />{publication.detail}</span>
          <span>{publication.venue}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section section-rule principle-panel">
    <blockquote>Research rigor is only useful in production if the system preserves the contract that made the result valid.</blockquote>
    <p class="muted">In clinical AI that means explicit fact authority, provenance, and acceptance states. In quantitative systems it means point-in-time data, leakage controls, reproducible evaluation, and a clean boundary between research artifacts and live state.</p>
  </section>

  <section class="container section contact-panel">
    <p class="eyebrow">Senior / lead roles</p>
    <h2>Need someone who can own the whole system?</h2>
    <p>I'm interested in applied AI leadership and senior engineering roles where model capability has to become reliable software: agent platforms, computer vision/video intelligence, multimodal AI, quantitative ML, distributed AI backends, and production delivery.</p>
    <div class="hero-actions">
      <a class="button primary" href={`mailto:${profile.email}`}>Start a conversation</a>
      <a class="button ghost" href={profile.github}>GitHub</a>
      <a class="button ghost" href={profile.linkedin}>LinkedIn</a>
      <a class="button ghost" href={withBase('/resume')}>Full résumé</a>
    </div>
  </section>
</BaseLayout>
